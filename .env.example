APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# === En production (HTTPS), DÉCOMMENTER les 4 lignes ci-dessous ===
# SESSION_SECURE_COOKIE=true       # cookie envoyé uniquement sur HTTPS
# SESSION_HTTP_ONLY=true           # cookie inaccessible depuis JS (anti-XSS)
# SESSION_SAME_SITE=lax            # protection CSRF basique (strict si pas de cross-site nécessaire)
# SESSION_ENCRYPT=true             # session payload chiffré en DB

# Origines CORS supplémentaires (CSV) — APP_URL et chrome-extension://* sont déjà autorisés.
# Exemple : CORS_EXTRA_ORIGINS=https://lesrats.com,https://staging.lesrats.com
# CORS_EXTRA_ORIGINS=

# Expiration des tokens API Sanctum (minutes). null = jamais expire (à éviter en prod).
# 129600 = 90 jours.
SANCTUM_TOKEN_EXPIRATION=129600

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Groq AI (free API for content optimization)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Fal.ai (image generation) — cle unique partagee pour tous les users
FAL_API_KEY=

# Laravel Nightwatch — application monitoring (token from Laravel Cloud / Nightwatch dashboard)
NIGHTWATCH_TOKEN=

# PostHog — product analytics (phc_* token from eu.posthog.com → Project Settings → Project API Key)
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_DISABLED=false
