{
  "manifest_version": 3,
  "name": "LesRats - AliExpress, Printables Importer & Etsy Publisher",
  "version": "2.0.0",
  "description": "Importez des produits AliExpress et Printables, puis publiez-les facilement sur Etsy",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "nativeMessaging"
  ],
  "commands": {
    "quick-import": {
      "suggested_key": {
        "default": "Alt+Shift+I",
        "mac": "Alt+Shift+I"
      },
      "description": "Importer rapidement le produit vers LesRats"
    }
  },
  "host_permissions": [
    "https://*.aliexpress.com/*",
    "https://fr.aliexpress.com/*",
    "https://*.printables.com/*",
    "https://www.printables.com/*",
    "https://*.etsy.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.laravel.cloud/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.aliexpress.com/item/*.html*",
        "https://fr.aliexpress.com/item/*.html*"
      ],
      "js": ["lib/secure-storage.js", "content/aliexpress.js", "content/aliexpress-panel.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.printables.com/model/*",
        "https://www.printables.com/model/*"
      ],
      "js": ["content/printables.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.etsy.com/*listing-editor*",
        "https://www.etsy.com/*listing-editor*"
      ],
      "js": ["content/etsy.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.etsy.com/*listing-editor*",
        "https://www.etsy.com/*listing-editor*"
      ],
      "js": ["content/etsy-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.laravel.cloud/*"
      ],
      "js": ["content/lesrats.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon32.png", "icons/icon48.png"],
      "matches": ["https://*.aliexpress.com/*"]
    }
  ]
}
